# Kopieer dit bestand naar .env en vul je eigen gegevens in.
# .env staat in .gitignore: zet je sleutels NOOIT in git.

# --- Taalmodel (formuleert de antwoorden) ---
# Optie A: lokaal via Ollama (gratis, volledig privé)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=qwen2.5:7b

# Optie B: Gemini (sneller; sleutel via aistudio.google.com)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=je-gemini-sleutel
# CHAT_MODEL=gemini-...-flash
# REASONING_EFFORT=low
# EVAL_DELAY=5

# --- Zoekmodel (embeddings) ---
# Mag bij een andere aanbieder staan dan het taalmodel. Na het wisselen van
# EMBED_MODEL altijd opnieuw "python -m app.ingest" draaien.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# --- Zoeken ---
TOP_K=5
# Onder deze score (0-1; voor bge-m3 rond 0.45) vindt de bot de stukken niet relevant
# genoeg en antwoordt hij "weet ik niet" zonder het taalmodel te vragen.
MIN_SCORE=0.45

# Contact waar de bot naar verwijst als hij het antwoord niet weet
SCHOOL_CONTACT=info@brakken.nl
